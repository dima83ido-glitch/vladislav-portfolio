# Public URL of the deployed site (no trailing slash).
# Used for canonical links, the sitemap, and Open Graph / Twitter card metadata.
# Locally this can be left unset — it falls back to a placeholder in src/lib/data/site.ts.
# In production (e.g. on Render), set this to your real service URL or custom domain.
NEXT_PUBLIC_SITE_URL=https://vladislav-portfolio.onrender.com

# Postgres connection string for the app's database (users, sessions,
# verification codes, reviews). Get one from https://neon.tech (free tier).
# Required for auth, reviews, and the admin dashboard to work.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Resend API key used to send the passwordless login verification-code
# emails. Get one from https://resend.com. If left unset in development,
# codes are printed to the server console instead of emailed — the app
# still works, just without real delivery. Required in production.
RESEND_API_KEY=

# The "From" address used when sending verification-code emails. Must be
# a sender/domain verified in your Resend account.
RESEND_FROM_EMAIL="Vladislav <noreply@yourdomain.com>"

# The email address that gets promoted to the admin role (and therefore
# access to /admin) the first time it signs in via the passwordless
# email-code flow. Set this to your own email.
ADMIN_EMAIL=you@example.com

# --- Optional / gated features below ---
# Everything in this section is safe to leave blank: card payments and
# media uploads simply show a "not configured yet" state until real
# values are provided. Nothing crashes or fakes success without them.

# Stripe (card payments). Get a test-mode secret key from
# https://dashboard.stripe.com/test/apikeys — only the secret key is
# needed since checkout uses Stripe's hosted redirect page, not
# client-side Stripe.js. STRIPE_WEBHOOK_SECRET comes from creating a
# webhook endpoint pointing at <your-site>/api/webhooks/stripe in the
# Stripe Dashboard, listening for checkout.session.completed and
# payment_intent.payment_failed.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloudinary (portfolio image uploads in the admin CMS, and user avatar
# uploads). Get these from https://console.cloudinary.com — free tier is
# plenty for this. Also set the same three vars in the Render dashboard
# (Environment tab) for production — render.yaml intentionally leaves them
# unsynced since they're secrets.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
